# ==============================================================================
# Poornima University Examination Archive Portal (PYQP)
# Environment Variables Template
# Copy this file to .env.local for local development, or add these in Vercel.
# ==============================================================================

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_WEBHOOK_SECRET=your-supabase-webhook-secret

# Admin Configuration
ADMIN_EMAIL=your-admin@poornima.edu.in
ADMIN_DISPLAY_NAME=Super Admin
JWT_SECRET=your-random-jwt-secret-key

# AI Assistant (Google Gemini)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash-lite

# Google OAuth, Drive & Sheets Integration
NEXT_PUBLIC_GOOGLE_SIGNIN_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_SIGNIN_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
CLIENT_ID=your-google-service-client-id
CLIENT_SECRET=your-google-client-secret
DRIVE_REFRESH_TOKEN=your-google-drive-refresh-token
SHEET_ID=your-google-sheet-id
DRIVE_FOLDER_ID=your-google-drive-folder-id

# Cloudflare Turnstile CAPTCHA (Optional / Production)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key
CAPTCHA_SECRET=your-turnstile-secret-key

# Email (SMTP for Password Reset)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@poornima.edu.in
SMTP_PASSWORD=your-app-password
PASSWORD_RESET_FROM="Poornima University Examination Cell" <your-email@poornima.edu.in>

# Security Contact
SECURITY_CONTACT_EMAIL=library@poornima.edu.in
