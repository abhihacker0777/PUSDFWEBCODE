NODE_ENV=production
PORT=3000
TRUST_PROXY=1

BASE_URL=https://api.your-domain.example
FRONTEND_URL=https://pyqp.your-domain.example
PASSWORD_RESET_URL=https://pyqp.your-domain.example/reset-password

JWT_SECRET=replace_with_32_plus_character_secret
ADMIN_EMAIL=admin@poornima.edu.in
ADMIN_DISPLAY_NAME=Main Admin
ADMIN_ALLOWED_IPS=203.0.113.10,198.51.100.20
ADMIN_SESSION_VERSION=1

REDIS_URL=redis://default:password@host:6379

CAPTCHA_SECRET=replace_with_cloudflare_turnstile_secret
CAPTCHA_VERIFY_URL=https://challenges.cloudflare.com/turnstile/v0/siteverify

# Optional: webhook-based sheet mirror (alternative to the inline mirror that
# already runs during upload/delete). Leave SUPABASE_WEBHOOK_SECRET unset to
# keep this disabled - nothing changes until you configure it.
# 1. Generate a random secret and set it here.
# 2. In Supabase: Database -> Webhooks -> Create a new webhook on the "papers"
#    table (Insert, Update, Delete) -> POST to https://<your-backend>/webhooks/supabase/papers
#    -> add an HTTP header "x-webhook-secret: <the same secret>".
# 3. Once you've confirmed it fires correctly, set DISABLE_INLINE_SHEET_MIRROR=true
#    to stop double-mirroring (inline AND webhook both running).
SUPABASE_WEBHOOK_SECRET=
DISABLE_INLINE_SHEET_MIRROR=false

RESEND_API_KEY=replace_with_resend_api_key
PASSWORD_RESET_FROM=PYQP Admin <noreply@your-verified-domain.example>

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace_with_supabase_service_role_key
SUPABASE_PAPERS_TABLE=papers
SUPABASE_ADMIN_USERS_TABLE=admin_users

CLIENT_ID=replace_with_google_oauth_client_id
CLIENT_SECRET=replace_with_google_oauth_client_secret
DRIVE_REFRESH_TOKEN=replace_with_google_refresh_token
GOOGLE_SIGNIN_CLIENT_ID=replace_with_google_signin_client_id
SHEET_ID=replace_with_google_sheet_id
SHEET_URL=https://docs.google.com/spreadsheets/d/replace_with_sheet_id/edit
DRIVE_FOLDER_ID=replace_with_google_drive_folder_id
DRIVE_ACCESS_DOMAIN=poornima.edu.in

ASSISTANT_EMAIL_DOMAIN=poornima.edu.in
ASSISTANT_REQUESTS_SHEET=AI Requests
SARVAM_API_KEY=replace_with_sarvam_api_key
SARVAM_MODEL=sarvam-30b
